                    <file category="other" name="Middlewares/Third_Party/parson/_htmresc/favicon.png"/>
                    <file category="other" name="Middlewares/Third_Party/parson/_htmresc/mini-st.css"/>
                    <file category="other" name="Middlewares/Third_Party/parson/_htmresc/mini-st_2020.css"/>
                    <file category="other" name="Middlewares/Third_Party/parson/_htmresc/st_logo.png"/>
                    <file category="other" name="Middlewares/Third_Party/parson/_htmresc/st_logo_2020.png"/>
                    <file category="other" name="Middlewares/Third_Party/parson/_htmresc/Update.svg"/>
                    <file category="other" name="Middlewares/Third_Party/parson/tests/test_1_1.txt" public="false"/>
                    <file category="other" name="Middlewares/Third_Party/parson/tests/test_1_2.txt" public="false"/>
                    <file category="other" name="Middlewares/Third_Party/parson/tests/test_1_3.txt" public="false"/>
                    <file category="other" name="Middlewares/Third_Party/parson/tests/test_2.txt" public="false"/>
                    <file category="other" name="Middlewares/Third_Party/parson/tests/test_2_comments.txt" public="false"/>
                    <file category="other" name="Middlewares/Third_Party/parson/tests/test_2_pretty.txt" public="false"/>
                    <file category="other" name="Middlewares/Third_Party/parson/tests/test_5.txt" public="false"/>
                    <file category="other" name="Middlewares/Third_Party/parson/SW_Security_Level.md"/>
                </files>
            </component>
        </bundle>
        <bundle Cbundle="STM32_BLE_Manager" Cclass="BLE_Manager" Cversion="2.2.0">
            <description>STM32_BLE_Manager middleware manager according to the STM32 Bluetooth middleware APIs.</description>
            <doc>Middlewares/ST/STM32_BLE_Manager/Documentation/STM32_BLE_Manager_Library.chm</doc>
            <component Cgroup="BLE_Manager" maxInstances="1">
                <description>Add bluetooth services using vendor specific profiles</description>
                <files>
                    <file category="header" name="Middlewares/ST/STM32_BLE_Manager/Inc/ble_manager.h"/>
                    <file category="header" name="Middlewares/ST/STM32_BLE_Manager/Inc/ble_manager_common.h"/>
                    <file category="header" name="Middlewares/ST/STM32_BLE_Manager/Inc/ble_manager_control.h"/>
                    <file category="source" name="Middlewares/ST/STM32_BLE_Manager/Src/ble_manager.c"/>
                    <file category="other" name="Middlewares/ST/STM32_BLE_Manager/_htmresc/Add button.svg"/>
                    <file category="other" name="Middlewares/ST/STM32_BLE_Manager/_htmresc/favicon.png"/>
                    <file category="other" name="Middlewares/ST/STM32_BLE_Manager/_htmresc/mini-st.css"/>
                    <file category="other" name="Middlewares/ST/STM32_BLE_Manager/_htmresc/st_logo.png"/>
                    <file category="other" name="Middlewares/ST/STM32_BLE_Manager/_htmresc/Update.svg"/>
                    <file category="other" name="Middlewares/ST/STM32_BLE_Manager/LICENSE.txt" public="false"/>
                    <file category="other" name="Middlewares/ST/STM32_BLE_Manager/Release_Notes.html" public="false"/>
                    <file category="other" name="Middlewares/ST/STM32_BLE_Manager/SW_Security_Level.md"/>
                </files>
            </component>
        </bundle>
        <bundle Cbundle="STM32WBA Applications" Cclass="Device" Cversion="1.2.0">
            <description>BLE sample applications for STM32WBA NCP configuration</description>
            <doc>https://www.st.com/resource/en/user_manual/um3529-getting-started-with-xcubewba-bluetooth-le-software-expansion-for-stm32cube-stmicroelectronics.pdf</doc>
            <component Cgroup="Application" Cvariant="BeaconHCI" condition="RCP Application Condition" maxInstances="1">
                <description>Beacon sample application for RCP Transparent Mode</description>
                <RTE_Components_h>#define BEACON_HCI</RTE_Components_h>
                <files/>
            </component>
            <component Cgroup="Application" Cvariant="Beacon" condition="NCP Application Condition" maxInstances="1">
                <description>Beacon sample application</description>
                <RTE_Components_h>#define BEACON</RTE_Components_h>
                <files/>
            </component>
            <component Cgroup="Application" Cvariant="SampleApp" condition="NCP Application Condition" maxInstances="1">
                <description>SampleApp sample application</description>
                <RTE_Components_h>#define SAMPLE_APP</RTE_Components_h>
                <files/>
            </component>
            <component Cgroup="Application" Cvariant="SensorDemoBLESensor" condition="NCP Application Condition" maxInstances="1">
                <description>SensorDemo sample application for the ST BLE Sensor app</description>
                <RTE_Components_h>#define SENSOR_DEMO_BS</RTE_Components_h>
                <files/>
            </component>
            <component Cgroup="Application" Cvariant="VirtualCOMPort" condition="NCP Application Condition" maxInstances="1">
                <description>Virtual_COM_Port sample application</description>
                <RTE_Components_h>#define VIRTUAL_COM_PORT</RTE_Components_h>
                <files/>
            </component>
            <component Cgroup="Application" Cvariant="BLE_FOTA" condition="JSON" maxInstances="1">
                <description>BLE FOTA sample application</description>
                <RTE_Components_h>#define FOTA</RTE_Components_h>
                <files/>
            </component>
        </bundle>
    </components>
    <examples>
        <example doc="README.md" folder="Projects/NUCLEO-U385RG-Q/Applications/UART/Beacon" name="UART/Beacon" public="false" version="1.2.0">
            <description>This example shows how to implement a Bluetooth LE Beacon device using an
STM32 Nucleo board connected to an STM32WBA network coprocessor and 
a Smartphone with Bluetooth LE.</description>
            <board Dvendor="STMicroelectronics:13" name="NUCLEO-U385RG-Q" vendor="STMicroelectronics"/>
            <project>
                <environment folder="UART/Beacon" load="Beacon.ioc" name="stm32cubemx"/>
                <environment folder="EWARM" load="Beacon.ewp" name="iar"/>
                <environment folder="MDK-ARM" load="Beacon.uvprojx" name="uv"/>
                <environment folder="STM32CubeIDE" load=".cproject" name="stm32cubeide"/>
            </project>
            <attributes/>
        </example>
        <example doc="README.md" folder="Projects/NUCLEO-U385RG-Q/Applications/SPI/Beacon" name="SPI/Beacon" public="false" version="1.2.0">
            <description>This example shows how to implement a Bluetooth LE Beacon device using an
STM32 Nucleo board connected to an STM32WBA network coprocessor and 
a Smartphone with Bluetooth LE.</description>
            <board Dvendor="STMicroelectronics:13" name="NUCLEO-U385RG-Q" vendor="STMicroelectronics"/>
            <project>
                <environment folder="SPI/Beacon" load="Beacon.ioc" name="stm32cubemx"/>
                <environment folder="EWARM" load="Beacon.ewp" name="iar"/>
                <environment folder="MDK-ARM" load="Beacon.uvprojx" name="uv"/>
                <environment folder="STM32CubeIDE" load=".cproject" name="stm32cubeide"/>
            </project>
            <attributes/>
        </example>
        <example doc="README.md" folder="Projects/NUCLEO-U385RG-Q/Applications/UART/BeaconHCI" name="UART/BeaconHCI" public="false" version="1.2.0">
            <description>This example shows how to implement a Beacon device using only HCI commands. The communication
is done using an STM32 Nucleo board, equipped with a STM32WBA
expansion board, and a Smartphone with Bluetooth LE.</description>
            <board Dvendor="STMicroelectronics:13" name="NUCLEO-U385RG-Q" vendor="STMicroelectronics"/>
            <project>
                <environment folder="UART/BeaconHCI" load="BeaconHCI.ioc" name="stm32cubemx"/>
                <environment folder="EWARM" load="BeaconHCI.ewp" name="iar"/>
                <environment folder="MDK-ARM" load="BeaconHCI.uvprojx" name="uv"/>
                <environment folder="STM32CubeIDE" load=".cproject" name="stm32cubeide"/>
            </project>
            <attributes/>
        </example>
        <example doc="README.md" folder="Projects/NUCLEO-U385RG-Q/Applications/SPI/BeaconHCI" name="SPI/BeaconHCI" public="false" version="1.2.0">
            <description>This example shows how to implement a Beacon device using only HCI commands. The communication
is done using an STM32 Nucleo board, equipped with a STM32WBA
expansion board, and a Smartphone with Bluetooth LE.</description>
            <board Dvendor="STMicroelectronics:13" name="NUCLEO-U385RG-Q" vendor="STMicroelectronics"/>
            <project>
                <environment folder="SPI/BeaconHCI" load="BeaconHCI.ioc" name="stm32cubemx"/>
                <environment folder="EWARM" load="BeaconHCI.ewp" name="iar"/>
                <environment folder="MDK-ARM" load="BeaconHCI.uvprojx" name="uv"/>
                <environment folder="STM32CubeIDE" load=".cproject" name="stm32cubeide"/>
            </project>
            <attributes/>
        </example>
        <example doc="README.md" folder="Projects/NUCLEO-U385RG-Q/Applications/UART/BLE_FOTA" name="UART/BLE_FOTA" public="false" version="1.2.0">
            <description>The BLE_FOTA application shows how to use the dual bank flash features
to allow Firmware-Over-the-Air update of a running program without using
the BootLoader.</description>
            <board Dvendor="STMicroelectronics:13" name="NUCLEO-U385RG-Q" vendor="STMicroelectronics"/>
            <project>
                <environment folder="UART/BLE_FOTA" load="BLE_FOTA.ioc" name="stm32cubemx"/>
                <environment folder="EWARM" load="BLE_FOTA.ewp" name="iar"/>
                <environment folder="MDK-ARM" load="BLE_FOTA.uvprojx" name="uv"/>
                <environment folder="STM32CubeIDE" load=".cproject" name="stm32cubeide"/>
            </project>
            <attributes/>
        </example>
        <example doc="README.md" folder="Projects/NUCLEO-U385RG-Q/Applications/SPI/BLE_FOTA" name="SPI/BLE_FOTA" public="false" version="1.2.0">
            <description>The BLE_FOTA application shows how to use the dual bank flash features
to allow Firmware-Over-the-Air update of a running program without using
the BootLoader.</description>
            <board Dvendor="STMicroelectronics:13" name="NUCLEO-U385RG-Q" vendor="STMicroelectronics"/>
            <project>
                <environment folder="SPI/BLE_FOTA" load="BLE_FOTA.ioc" name="stm32cubemx"/>
                <environment folder="EWARM" load="BLE_FOTA.ewp" name="iar"/>
                <environment folder="MDK-ARM" load="BLE_FOTA.uvprojx" name="uv"/>

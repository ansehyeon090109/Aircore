<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package Dvendor="STMicroelectronics:13" schemaVersion="1.7.56" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
    <vendor>STMicroelectronics</vendor>
    <name>X-CUBE-WBA</name>
    <description>STM32WBA NCP support package
  - This version is compatible with STM32CubeMX V6.19.x (not fully compatible with older releases)
  - Create sample applications with STM32CubeMX V6.19.x</description>
    <url>http://sw-center.st.com/packs/x-cube/</url>
    <license>Package_license.md</license>
    <releases>
        <release date="2026-11-11" version="1.2.0">STM32WBA NCP support package
  - This version is compatible with STM32CubeMX V6.19.x (not fully compatible with older releases)
  - Create sample applications with STM32CubeMX V6.19.x</release>
        <release date="2026-06-12" version="1.1.0">STM32WBA NCP support package
  - This version is compatible with STM32CubeMX V6.18.x (not fully compatible with older releases)
  - Create sample applications with STM32CubeMX V6.18.x</release>
    </releases>
    <keywords>
        <keyword>CUBE_RULES_COMPLIANT</keyword>
        <keyword>ARM</keyword>
        <keyword>Cortex-M</keyword>
        <keyword>STMicroelectronics</keyword>
        <keyword>Wireless</keyword>
        <keyword>Bluetooth Low Energy</keyword>
        <keyword>IMPLEMENTED_WITH_STM32CUBEMX</keyword>
        <keyword>IS_CONTEXT_EXCLUSIVE</keyword>
        <keyword>DNS_BUSIO_X_CONTEXT_SHARING</keyword>
        <keyword>DOES_NOT_SUPPORT_SECURE</keyword>
    </keywords>
    <taxonomy>
        <description Cclass="BLE_Manager">BLE_Manager</description>
        <description Cclass="Device">Device</description>
        <description Cclass="Data Exchange">Data Exchange</description>
        <description Cclass="Wireless">Wireless</description>
    </taxonomy>
    <conditions>
        <condition id="Cortex-M Device">
            <description>Cortex-M processor based device: Cortex-M0, Cortex-M0+, Cortex-M3, Cortex-M4, Cortex-M7, Cortex-M33</description>
            <accept Dcore="Cortex-M0"/>
            <accept Dcore="Cortex-M0+"/>
            <accept Dcore="Cortex-M3"/>
            <accept Dcore="Cortex-M4"/>
            <accept Dcore="Cortex-M7"/>
            <accept Dcore="Cortex-M33"/>
        </condition>
        <condition id="BLEStack Condition">
            <description>Cortex-M Device and board setup (STM32WBA)</description>
            <require condition="Cortex-M Device"/>
            <require Cbundle="BLE_CP" Cclass="Wireless" Cgroup="BLE_CP" Csub="HCI_TL_INTERFACE" Cversion="1.1.0"/>
            <require Cbundle="BLE_CP" Cclass="Wireless" Cgroup="BLE_CP" Csub="Utils" Cversion="1.1.0"/>
        </condition>
        <condition id="TL API Condition">
            <description>Request the API BLE Transport Layer</description>
            <require Cbundle="BLE_CP" Cclass="Wireless" Cgroup="BLE_CP" Csub="HCI_TL_INTERFACE" Cversion="1.1.0"/>
        </condition>
        <condition id="PARSON">
            <require Cclass="Data Exchange" Cgroup="parson"/>
        </condition>
        <condition id="NCP Application Condition">
            <description>Constraint for application connected to NCP Transparent Mode</description>
            <require Cbundle="BLE_CP" Cclass="Wireless" Cgroup="BLE_CP" Csub="Controller" Cvariant="NCP"/>
            <require Cbundle="BLE_CP" Cclass="Wireless" Cgroup="BLE_CP" Csub="HCI_TL_INTERFACE"/>
            <deny Cbundle="STM32_BLE_Manager" Cclass="BLE_Manager" Cgroup="BLE_Manager"/>
        </condition>
        <condition id="RCP Application Condition">
            <description>Contraints fot application examples connected to Radio Coprocessor Transparent Mode</description>
            <require Cbundle="BLE_CP" Cclass="Wireless" Cgroup="BLE_CP" Csub="Controller" Cvariant="RCP"/>
            <require Cbundle="BLE_CP" Cclass="Wireless" Cgroup="BLE_CP" Csub="HCI_TL_INTERFACE"/>
            <deny Cbundle="STM32_BLE_Manager" Cclass="BLE_Manager" Cgroup="BLE_Manager"/>
        </condition>
        <condition id="BLE_MANAGER">
            <description>Middleware required by FOTA application</description>
            <require Cclass="BLE_Manager" Cgroup="BLE_Manager"/>
        </condition>
        <condition id="JSON">
            <require Cbundle="BLE_CP" Cclass="Wireless" Cgroup="BLE_CP" Csub="Controller" Cvariant="NCP"/>
            <require Cbundle="BLE_CP" Cclass="Wireless" Cgroup="BLE_CP" Csub="HCI_TL_INTERFACE"/>
            <require condition="BLE_MANAGER"/>
            <require condition="PARSON"/>
        </condition>
    </conditions>
    <components>
        <bundle Cbundle="BLE_CP" Cclass="Wireless" Cversion="1.2.0">
            <description>BLE stack for STM32WBA coprocessor</description>
            <doc>https://www.st.com/resource/en/user_manual/um3529-getting-started-with-xcubewba-bluetooth-le-software-expansion-for-stm32cube-stmicroelectronics.pdf</doc>
            <component Cgroup="BLE_CP" Csub="Controller" Cvariant="NCP" condition="BLEStack Condition" isDefaultVariant="true" maxInstances="1">
                <description>Host Controller Interface (HCI) for Network Coprocessor Transparent Mode</description>
                <files>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_const.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_core.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_defs.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_events.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_gap_aci.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_gatt_aci.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_gen_aci.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_hal_aci.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_hci_le.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_l2cap_aci.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_legacy.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_std.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_types.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_vs_codes.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/hci.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/hci_const.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/hci_parser.h"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/controller/ble_gap_aci.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/controller/ble_gatt_aci.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/controller/ble_gen_aci.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/controller/ble_hal_aci.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/controller/ble_l2cap_aci.c"/>
                    <file category="other" name="Middlewares/ST/BLE_CP/LICENSE.txt" public="false"/>
                    <file category="other" name="Middlewares/ST/BLE_CP/Release_Notes.html" public="false"/>
                </files>
            </component>
            <component Cgroup="BLE_CP" Csub="Controller" Cvariant="RCP" condition="BLEStack Condition" maxInstances="1">
                <description>Host Controller Interface (HCI) for Radio Coprocessor Transparent Mode</description>
                <files>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_const.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_core.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_defs.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_events.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_hal_aci.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_hci_le.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_legacy.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_std.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_types.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/ble_vs_codes.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/hci.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/hci_const.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/includes/hci_parser.h"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/controller/ble_hal_aci.c"/>
                </files>
            </component>
            <component Cgroup="BLE_CP" Csub="HCI_TL_INTERFACE" Cvariant="SPI" maxInstances="1">
                <description>CI Transport Layer Interface based on User Board definition (use a basic set of already implemented APIs)</description>
                <RTE_Components_h>#define HCI_TL
#define HCI_TL_INTERFACE
#define USE_SPI</RTE_Components_h>
                <files>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/ble_events.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/ble_hci_le.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/hci_parser.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/hci_tl_patterns/Basic/hci_tl.c"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/hci/hci_tl_patterns/Basic/hci_tl.h"/>
                    <file category="doc" name="Middlewares/ST/BLE_CP/doc/STM32WBA_BLE_Wireless_Interface.html"/>
                </files>
            </component>
            <component Cgroup="BLE_CP" Csub="HCI_TL_INTERFACE" Cvariant="UART" isDefaultVariant="true" maxInstances="1">
                <description>CI Transport Layer Interface based on User Board definition (use a basic set of already implemented APIs)</description>
                <RTE_Components_h>#define HCI_TL
#define HCI_TL_INTERFACE
#define USE_UART</RTE_Components_h>
                <files>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/ble_events.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/ble_hci_le.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/hci_parser.c"/>
                    <file category="source" name="Middlewares/ST/BLE_CP/hci/hci_tl_patterns/Basic/hci_tl.c"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/hci/hci_tl_patterns/Basic/hci_tl.h"/>
                    <file category="doc" name="Middlewares/ST/BLE_CP/doc/STM32WBA_BLE_Wireless_Interface.html"/>
                </files>
            </component>
            <component Cgroup="BLE_CP" Csub="Utils" maxInstances="1">
                <description>Utilities</description>
                <files>
                    <file category="source" name="Middlewares/ST/BLE_CP/utils/ble_list.c"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/utils/ble_list.h"/>
                    <file category="header" name="Middlewares/ST/BLE_CP/utils/compiler.h"/>
                </files>
            </component>
        </bundle>
        <bundle Cbundle="parson" Cclass="Data Exchange" Cvendor="Third_Party" Cversion="1.5.3">
            <description>Parson is a lighweight json library written in C.</description>
            <doc>Middlewares/Third_Party/parson/Release_Notes.html</doc>
            <component Cgroup="parson" maxInstances="1">
                <description>Parson is a lighweight json library written in C.</description>
                <RTE_Components_h>#define USE_PARSON</RTE_Components_h>
                <files>
                    <file category="source" name="Middlewares/Third_Party/parson/parson.c"/>
                    <file category="header" name="Middlewares/Third_Party/parson/parson.h"/>
                    <file category="other" name="Middlewares/Third_Party/parson/CMakeLists.txt" public="false"/>
                    <file category="other" name="Middlewares/Third_Party/parson/LICENSE"/>
                    <file category="other" name="Middlewares/Third_Party/parson/Makefile"/>
                    <file category="other" name="Middlewares/Third_Party/parson/meson.build"/>
                    <file category="other" name="Middlewares/Third_Party/parson/package.json"/>
                    <file category="other" name="Middlewares/Third_Party/parson/README.md"/>
                    <file category="other" name="Middlewares/Third_Party/parson/Release_Notes.html" public="false"/>
                    <file category="other" name="Middlewares/Third_Party/parson/st_readme.txt" public="false"/>

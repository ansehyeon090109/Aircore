        </condition>
        <condition id="CM55 GNU ARMC6 Condition">
            <description>CortexM55 / GNU compiler -or-  ARM compiler 6</description>
            <accept condition="CM55 ARMC6 Condition"/>
            <accept condition="CM55 GNU Condition"/>
        </condition>

    <vendor>STMicroelectronics</vendor>
    <name>eDS-WB_DPC_3PH2L-BIDIR</name>
    <description>DPC Firmware pack for a 3-phase 2-Level Bidirectional (B6) AC/DC Converter</description>
    <url>http://sw-center.st.com/packs/x-cube/</url>
    <license>Software License Agreement.pdf</license>
    <releases>
        <release date="2026-02-24" version="1.1.1">Expansion Pack for 3-phase 2-Level Bidirectional PFC (B6) Application

            The package works only with .ioc projects generated by eDesign-Suite Digital Power Workbench 3-phase 2-Level Bidirectional PFC (B6) web solution.

            The URL to access eDesignSuite Digital Power Workbench is https://eds.st.com/eds-console/#/digital-power-workbench

            To start directly a 3-phase 2-Level Bidirectional PFC (B6) design use

            https://eds.st.com/vienna-bidir/?msg={"data":{"application":"b6-afe_html","specs":{"ic":"stm32g474retx:b6-afe","input":{"v":{"min":185,"max":265},"f":50},"output":[{"v":800,"p":11000}]}},"action":"new_design"}

            Generated with STM32PackCreator 4.0.0</release>
        <release date="2025-10-08" version="1.1.0">This package version is compatible starting from STM32CubeMX 6.14.0</release>
        <release date="2025-07-30" version="1.0.2">This package version is compatible starting from STM32CubeMX 6.14.0</release>
    </releases>
